# ign8t MCP server credentials.
# Set this in the Claude Code environment settings (or your local shell);
# .mcp.json reads it via ${IGN8T_API_KEY}. Never commit the real key.
IGN8T_API_KEY=ign8t_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default ign8t project for this repo (safe to commit — not a secret).
IGN8T_PROJECT_ID=9d635318-4ded-4a09-8dca-da9b0617eeca

# Supabase (미설정 시 클라이언트 도메인 스토어로 동작)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관측성 — 미설정 시 no-op (docs/deployment.md 참고)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_LANGFUSE_PUBLIC_KEY=
